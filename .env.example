# Copy to .env locally. Use unique random secrets; never commit the populated file.
MONGO_ROOT_USERNAME=governance_admin
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
MONGO_APP_USERNAME=governance_app
MONGO_APP_PASSWORD=replace-with-a-different-long-random-password
DB_NAME=governance
EDGE_SIGNING_SECRET=replace-with-at-least-32-random-bytes
EMERGENT_LLM_KEY=
CORS_ORIGINS=http://localhost:8080
STUDIO_PORT=8080
# Set this only if you want compose image names under your Docker Hub account.
DOCKERHUB_USERNAME=your-dockerhub-username
